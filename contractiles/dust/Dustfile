# Dustfile - recovery and rollback semantics for Evidence Graph (bofig)

version: 1

recovery:
  database:
    - name: arango-rollback
      path: "ArangoDB evidence graph"
      rollback: "mix run -e 'EvidenceGraph.ArangoDB.reset_database()' && mix run priv/repo/seeds.exs"
      notes: "Reset ArangoDB to seed data state."

    - name: postgres-rollback
      path: "PostgreSQL user auth"
      rollback: "mix ecto.rollback"
      notes: "Roll back the last Ecto migration."

    - name: full-db-reset
      path: "All databases"
      rollback: "just db-reset"
      notes: "Full destructive reset of ArangoDB + PostgreSQL + reseed."

  container:
    - name: container-rollback
      event: "deploy.failure"
      undo: "podman stop evidence-graph && podman rm evidence-graph"
      notes: "Stop and remove failed container deployment."

    - name: compose-rollback
      event: "compose.failure"
      undo: "podman-compose down"
      notes: "Tear down all compose services."

  config:
    - name: config-rollback
      path: "config/runtime.exs"
      rollback: "git checkout HEAD~1 -- config/runtime.exs"
      notes: "Revert runtime config to previous known-good revision."

  evidence:
    - name: evidence-import-undo
      event: "batch-import.failure"
      undo: "mix run -e 'EvidenceGraph.Evidence.rollback_last_import()'"
      notes: "Undo a failed batch import, preserving existing evidence."

  dust-events:
    - name: mutation-log
      source: "ArangoDB audit collection"
      transform: "Export mutation log for forensic review."
      notes: "All GraphQL mutations are logged for reversibility analysis."
