#
# Evidence Graph — Production Environment Variables
# Copy to /etc/evidence-graph/env and fill in values.
# Permissions: chmod 600 /etc/evidence-graph/env; chown evidence_graph:evidence_graph /etc/evidence-graph/env
#
# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# --- Phoenix / Elixir ---

# Secret key for cookie signing and encryption.
# Generate with: mix phx.gen.secret
# Must be at least 64 bytes.
SECRET_KEY_BASE=

# Production hostname (used for URL generation, CORS, WebSocket origin checks).
# Example: evidencegraph.org
PHX_HOST=evidencegraph.org

# HTTP port the Phoenix server binds to (Nginx proxies to this).
# Default: 4000
PORT=4000

# --- PostgreSQL (user authentication only) ---

# Ecto database URL for the Postgres connection.
# Format: ecto://USER:PASSWORD@HOST:PORT/DATABASE
# Example: ecto://evidence_graph:secretpassword@127.0.0.1:5432/evidence_graph_prod
DATABASE_URL=

# Postgres connection pool size. Default: 10
# POOL_SIZE=10

# Set to "true" to enable IPv6 for Postgres connections.
# ECTO_IPV6=false

# --- ArangoDB (primary data store: documents + graph) ---

# ArangoDB HTTP endpoint.
# Example: http://127.0.0.1:8529  or  https://arangodb-instance.arangodb.cloud:8529
ARANGO_ENDPOINT=

# ArangoDB database name. Default: evidence_graph
ARANGO_DATABASE=evidence_graph

# ArangoDB credentials (basic auth).
ARANGO_USERNAME=
ARANGO_PASSWORD=

# ArangoDB connection pool size. Default: 10
# ARANGO_POOL_SIZE=10

# =============================================================================
# OPTIONAL VARIABLES
# =============================================================================

# --- Zotero Web API v3 (evidence import/sync) ---

# Zotero API key (generate at https://www.zotero.org/settings/keys).
# If not set, Zotero integration is disabled.
# ZOTERO_API_KEY=

# Zotero user ID (numeric, visible in your Zotero profile URL).
# ZOTERO_USER_ID=

# Zotero library type: "user" or "group". Default: user
# ZOTERO_LIBRARY_TYPE=user

# --- REST API Authentication ---

# API key for authenticating REST API requests.
# If not set, API key authentication is disabled.
# EVIDENCE_GRAPH_API_KEY=

# --- Email (Swoosh / Mailgun) ---

# Set to "false" to disable outbound email entirely.
# SWOOSH_API_CLIENT=false

# Mailgun API key and sending domain.
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.evidencegraph.org

# --- IPFS (Phase 2 — content-addressed evidence storage) ---

# IPFS HTTP API URL. If not set, IPFS integration is disabled.
# IPFS_API_URL=http://127.0.0.1:5001
